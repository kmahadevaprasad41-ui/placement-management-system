# ==============================================================================
# PLACEMENT MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# 1. DATABASE & SERVER-SIDE SECRETS (STRICTLY PRIVATE - SERVER ONLY)
DATABASE_URL="file:./dev.db"
JWT_SECRET="your-secure-jwt-signing-secret"

# 2. APPLICATION BRANDING & DEFAULTS
NEXT_PUBLIC_APP_NAME="Placement Management System"
NEXT_PUBLIC_INSTITUTION_NAME="Placement Management System"

# 3. FIREBASE CLIENT CONFIGURATION
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# 4. OPTIONAL: GOOGLE GEMINI AI API KEY (STRICTLY PRIVATE - SERVER ONLY)
# Get a free key at: https://aistudio.google.com
# If left blank, the AI Resume Agent automatically runs the built-in autonomous engine!
GEMINI_API_KEY=""
